#!/bin/sh
# Blocks pushes that would move main directly, and warns before a release tag.
#
# This is the client-side half of the guard. Unlike the private repos in this
# account, slip39-backup is public, so the authoritative rule is a server-side
# branch protection on main ("Require a pull request before merging", with
# "Do not allow bypassing" enabled). See CLAUDE.md for the exact setup and how
# to verify it. This hook exists so a mistake fails immediately and locally,
# with a message naming the way out, instead of after a network round-trip.
#
# Enable it per clone (git does not share hooks itself):
#     git config core.hooksPath .githooks
#
# Bypass deliberately, when you genuinely mean it:
#     git push --no-verify ...
#
# git feeds pre-push one line per ref being pushed on stdin:
#     <local ref> <local sha> <remote ref> <remote sha>

BLOCKED=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            echo "✗ Refusing to push directly to main." >&2
            echo "  main should only move through a merged pull request:" >&2
            echo "    git switch -c my-branch && git push -u origin my-branch && gh pr create" >&2
            BLOCKED=1
            ;;
        refs/tags/v*)
            # A version tag IS a release: .github/workflows/appimage.yml builds the
            # AppImage, checksums it and publishes a GitHub Release on tag push, and
            # that artifact is what people run against real wallets. Not blocked
            # outright, because tagging is a legitimate release step; this is a
            # deliberate speed bump so it is never done by reflex.
            echo "! Pushing release tag ${remote_ref#refs/tags/}: this PUBLISHES a release." >&2
            echo "  The AppImage it builds is what users run against real seed phrases." >&2
            echo "  Ensure the release commit is already on main via a merged PR." >&2
            ;;
    esac
done

if [ "$BLOCKED" -ne 0 ]; then
    echo "" >&2
    echo "  Override with --no-verify if you are certain (branch protection will still refuse)." >&2
    exit 1
fi

exit 0
