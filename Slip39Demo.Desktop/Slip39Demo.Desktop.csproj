<!-- Native Tails/Linux shell: Photino window rendering the shared Blazor UI via
     the system WebKitGTK (libwebkit2gtk-4.1 — preinstalled on Tails 7+). Blazor
     runs in-process on .NET; no browser, no localhost port, no Tor interaction.
     See docs/specs/2026-08-01-native-window-appimage-design.md. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Slip39Demo.UI\Slip39Demo.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
