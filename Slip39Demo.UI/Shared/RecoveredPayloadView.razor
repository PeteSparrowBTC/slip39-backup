@using Slip39Demo.Core.Payload

<div class="panel">
    <div class="banner banner-ok">✓ Wallet recovered</div>
    <div class="panel-body">
        @if (Payload is null)
        {
            <p>(no payload)</p>
        }
        else
        {
            <div class="field">
                <label class="field-label">Label</label>
                <code class="mono-block">@(Payload.Label ?? "(none)")</code>
            </div>

            <div class="field">
                <label class="field-label">Schema version</label>
                <code class="mono-block">@Payload.SchemaVersion</code>
            </div>

            @if (Payload.TopLevelSeedWords is not null)
            {
                <div class="field">
                    <label class="field-label">Seed words</label>
                    @if (revealTopSeed)
                    {
                        <ol class="words">
                            @foreach (var word in Payload.TopLevelSeedWords.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <li>@word</li>
                            }
                        </ol>
                    }
                    else
                    {
                        <button id="reveal-top-seed" class="btn btn-sm" @onclick="() => revealTopSeed = true">Reveal seed words</button>
                    }
                </div>
            }

            @foreach (var c in Payload.Cosigners)
            {
                <div class="panel">
                    <div class="panel-header">Cosigner: @c.Id (@c.WalletType)</div>
                    <div class="panel-body">
                        @if (c.SeedWords is not null)
                        {
                            <div class="field">
                                <label class="field-label">Seed words</label>
                                @if (revealedCosigners.Contains(c.Id))
                                {
                                    <ol class="words">
                                        @foreach (var word in c.SeedWords.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <li>@word</li>
                                        }
                                    </ol>
                                }
                                else
                                {
                                    <button class="btn btn-sm" @onclick="() => Reveal(c.Id)">Reveal seed words</button>
                                }
                            </div>
                        }
                        @if (c.Passphrase is not null)
                        {
                            <div class="field">
                                <label class="field-label">Passphrase</label>
                                <code class="mono-block">@c.Passphrase</code>
                            </div>
                        }
                        <div class="field">
                            <label class="field-label">Derivation path</label>
                            <code>@c.DerivationPath</code>
                        </div>
                        @if (c.XpubFingerprint is not null)
                        {
                            <div class="field">
                                <label class="field-label">Xpub fingerprint</label>
                                <code>@c.XpubFingerprint</code>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Payload.Descriptor is not null)
            {
                <div class="field">
                    <label class="field-label">Descriptor</label>
                    <code class="mono-block">@Payload.Descriptor</code>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public PayloadV1_1? Payload { get; set; }

    bool revealTopSeed;
    readonly HashSet<string> revealedCosigners = new();

    void Reveal(string cosignerId) => revealedCosigners.Add(cosignerId);
}
