@using Slip39Demo.UI.Shared

<div class="card mb-3">
    <div class="card-header">Threshold structure</div>
    <div class="card-body p-3">
        <div class="mb-3">
            <label class="form-label small">Group threshold</label>
            <input type="number" class="form-control form-control-sm"
                   @bind="GroupThreshold" @bind:event="oninput"
                   min="1" max="@Groups.Count" />
            <small class="text-muted">Number of groups that must contribute to reconstruct</small>
        </div>

        @for (var i = 0; i < Groups.Count; i++)
        {
            var idx = i;
            var g = Groups[idx];
            <div class="row g-2 align-items-end mb-2">
                <div class="col-4">
                    <label class="form-label small">Name</label>
                    <input class="form-control form-control-sm" @bind="g.Name" />
                </div>
                <div class="col-3">
                    <label class="form-label small">Threshold</label>
                    <input type="number" class="form-control form-control-sm" @bind="g.Threshold" min="1" max="@g.Count" />
                </div>
                <div class="col-3">
                    <label class="form-label small">Count</label>
                    <input type="number" class="form-control form-control-sm" @bind="g.Count" min="1" max="16" />
                </div>
                <div class="col-2">
                    @if (Groups.Count > 1)
                    {
                        <button class="btn btn-sm btn-outline-danger w-100" @onclick="() => Remove(idx)">×</button>
                    }
                </div>
            </div>
        }

        <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="Add">+ Add group</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<ShareGroupVm> Groups { get; set; } = null!;
    [Parameter] public int GroupThreshold { get; set; }
    [Parameter] public EventCallback<int> GroupThresholdChanged { get; set; }

    void Add() => Groups.Add(new ShareGroupVm { Name = $"group-{Groups.Count + 1}", Threshold = 2, Count = 3 });

    void Remove(int idx)
    {
        Groups.RemoveAt(idx);
        if (GroupThreshold > Groups.Count)
            GroupThresholdChanged.InvokeAsync(Groups.Count);
    }
}
