@using Slip39Demo.UI.Shared

<div class="panel">
    <div class="panel-header">Threshold structure</div>
    <div class="panel-body">
        <div class="field">
            <label class="field-label">Group threshold</label>
            <input type="number" class="input"
                   @bind="GroupThreshold" @bind:event="oninput"
                   min="1" max="@Groups.Count" />
            <p class="hint">Number of groups that must contribute to reconstruct</p>
        </div>

        @for (var i = 0; i < Groups.Count; i++)
        {
            var idx = i;
            var g = Groups[idx];
            <div class="cols">
                <div>
                    <label class="field-label">Name</label>
                    <input class="input" @bind="g.Name" />
                </div>
                <div>
                    <label class="field-label">Threshold</label>
                    <input type="number" class="input" @bind="g.Threshold" min="1" max="@g.Count" />
                </div>
                <div>
                    <label class="field-label">Count</label>
                    <input type="number" class="input" @bind="g.Count" min="1" max="16" />
                </div>
                <div>
                    @if (Groups.Count > 1)
                    {
                        <button class="btn btn-sm btn-danger btn-block" @onclick="() => Remove(idx)">×</button>
                    }
                </div>
            </div>
        }

        <button class="btn btn-sm" @onclick="Add">+ Add group</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<ShareGroupVm> Groups { get; set; } = null!;
    [Parameter] public int GroupThreshold { get; set; }
    [Parameter] public EventCallback<int> GroupThresholdChanged { get; set; }

    void Add() => Groups.Add(new ShareGroupVm { Name = $"group-{Groups.Count + 1}", Threshold = 2, Count = 3 });

    void Remove(int idx)
    {
        Groups.RemoveAt(idx);
        if (GroupThreshold > Groups.Count)
            GroupThresholdChanged.InvokeAsync(Groups.Count);
    }
}
