@page "/recoverer"
@using System.Text
@using CSharpFunctionalExtensions
@using Slip39Demo.Core.Age
@using Slip39Demo.Core.Payload
@using Slip39Demo.Core.Pgp
@using Slip39Demo.Core.Slip39
@using Slip39Demo.UI.Shared

<PageTitle>Recover wallet — SLIP-39 + age</PageTitle>

<div class="page-head">
    <h1 class="with-icon"><Icon Name="recover" /> Recover wallet</h1>
    <a href="/" class="btn btn-sm">← Home</a>
</div>

@* Recovery also handles the seed — same airgap indicator as Owner mode
   (informational here; recovery is not watermark-gated). *@
<ConnectivityBanner />

<div class="split">
    <div>
        <MnemonicInput @bind-MnemonicText="mnemonicText" />
        <CiphertextInput @bind-ArmorText="armorText" BinaryChanged="b => binaryFromUpload = b" />

        @if (errorMessage is not null)
        {
            <div class="banner banner-loud">@errorMessage</div>
        }

        <button class="btn btn-primary btn-block" @onclick="RecoverAsync" disabled="@isRecovering">
            @if (isRecovering)
            {
                <span class="spinner"></span> <text>Recovering…</text>
            }
            else
            {
                <text>Recover</text>
            }
        </button>
    </div>

    <div>
        @if (recovered is not null)
        {
            <RecoveredPayloadView Payload="recovered" />
        }
        else
        {
            <div class="panel">
                <div class="panel-body">
                    Provide threshold-many mnemonics and the encrypted payload,
                    then click Recover.
                </div>
            </div>
        }
    </div>
</div>

@code {
    string mnemonicText = "";
    string armorText = "";
    byte[]? binaryFromUpload;

    PayloadV1_1? recovered;
    string? errorMessage;
    bool isRecovering;

    async Task RecoverAsync()
    {
        errorMessage = null;
        recovered = null;
        isRecovering = true;
        try
        {
            await Task.Yield(); // let the spinner render

            var mnemonics = mnemonicText
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
            if (mnemonics.Count == 0)
            {
                errorMessage = "Paste at least one SLIP-39 mnemonic.";
                return;
            }

            var keyResult = Slip39Wrapping.CombineMnemonics(mnemonics);
            if (keyResult.IsFailure) { errorMessage = keyResult.Error; return; }

            var cipher = ResolveCiphertext();
            if (cipher.IsFailure) { errorMessage = cipher.Error; return; }

            // Four shapes can arrive: an age file or an OpenPGP envelope, each either
            // binary or ASCII armored. Classified in Core by content rather than by
            // file name, because the file may have been renamed, downloaded from a
            // password manager as "attachment.dat", or pasted through a note.
            //
            // The armored OpenPGP case is the one this page used to get wrong. It
            // checked only the high bit, which catches binary OpenPGP and misses
            // armor, since armor is ASCII. Armor is precisely what a password-manager
            // note holds, so the most likely payload an heir pastes was the one that
            // went to the wrong decryptor and came back reported as corrupt.
            var shape = CiphertextShapeDetector.Detect(cipher.Value);

            var unwrapped = shape.IsOpenPgp()
                // Both OpenPGP forms go here: PgpEnvelope strips armor itself.
                ? PgpEnvelope.Decrypt(cipher.Value, keyResult.Value)
                : Result.Success(cipher.Value);
            if (unwrapped.IsFailure)
            {
                errorMessage =
                    "This is an OpenPGP-wrapped payload (payload.age.gpg, an age file with a "
                    + $"second lock around it), but that lock would not open with these shares: {unwrapped.Error}";
                return;
            }

            // An age-armored payload still needs dearmoring, and it may have been
            // sitting inside the OpenPGP envelope just removed, so this is decided
            // from the unwrapped bytes rather than from the outer shape.
            var ageBytes = CiphertextShapeDetector.Detect(unwrapped.Value).IsAgeArmor()
                ? AgeArmor.Decode(Encoding.UTF8.GetString(unwrapped.Value))
                : Result.Success(unwrapped.Value);
            if (ageBytes.IsFailure) { errorMessage = ageBytes.Error; return; }

            var plain = AgePassphrase.Decrypt(ageBytes.Value, keyResult.Value);
            if (plain.IsFailure) { errorMessage = plain.Error; return; }

            var parsed = PayloadParser.Parse(Encoding.UTF8.GetString(plain.Value));
            if (parsed.IsFailure) { errorMessage = parsed.Error; return; }

            recovered = parsed.Value;
        }
        finally
        {
            isRecovering = false;
        }
    }

    // Returns the payload as bytes, WITHOUT interpreting it. Decoding used to happen
    // here, via AgeArmor.Decode on anything pasted, which rejected OpenPGP armor
    // outright: the pasted form of the file this tool now ships could not be
    // recovered at all. Classification belongs to CiphertextShapeDetector, so this
    // only decides where the bytes came from.
    Result<byte[]> ResolveCiphertext()
    {
        if (binaryFromUpload is not null && binaryFromUpload.Length > 0)
            return binaryFromUpload;
        if (!string.IsNullOrWhiteSpace(armorText))
            return Encoding.UTF8.GetBytes(armorText);
        return Result.Failure<byte[]>(
            "Provide the encrypted payload: the file itself, or its ASCII-armored text pasted in.");
    }
}
