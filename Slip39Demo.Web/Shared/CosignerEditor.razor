@using Slip39Demo.Web.Shared

<div class="card mb-3">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Cosigner @(Index + 1)</h6>
            @if (Removable)
            {
                <button class="btn btn-sm btn-outline-danger" @onclick="OnRemove">Remove</button>
            }
        </div>

        <div class="mb-2">
            <label class="form-label small">ID</label>
            <input class="form-control form-control-sm" @bind="Vm.Id" placeholder="e.g. main, trezor, cosigner_a" />
        </div>

        <div class="mb-2">
            <label class="form-label small">Seed words (leave empty to use top-level seed)</label>
            <input class="form-control form-control-sm font-monospace" @bind="Vm.SeedWords"
                   placeholder="abandon ability able about ..." />
        </div>

        <div class="mb-2">
            <label class="form-label small">Passphrase (optional)</label>
            <input class="form-control form-control-sm" @bind="Vm.Passphrase" placeholder="Leave empty if no passphrase" />
        </div>

        <div class="mb-2">
            <label class="form-label small">Derivation path</label>
            <input class="form-control form-control-sm font-monospace" @bind="Vm.DerivationPath" />
        </div>

        <div class="mb-2">
            <label class="form-label small">Xpub fingerprint (optional, hex)</label>
            <input class="form-control form-control-sm font-monospace" @bind="Vm.XpubFingerprint" placeholder="8 hex chars" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CosignerVm Vm { get; set; } = null!;
    [Parameter] public int Index { get; set; }
    [Parameter] public bool Removable { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
}
