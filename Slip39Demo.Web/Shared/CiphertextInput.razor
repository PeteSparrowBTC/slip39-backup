@using Microsoft.AspNetCore.Components.Forms

<div class="card mb-3">
    <div class="card-header">Encrypted payload (payload.age)</div>
    <div class="card-body p-3">
        <p class="small text-muted mb-2">
            Paste the ASCII-armored text (begins with <code>-----BEGIN AGE ENCRYPTED FILE-----</code>),
            OR upload the binary <code>payload.age</code> file.
        </p>
        <textarea class="form-control form-control-sm font-monospace" rows="6"
                  @bind="ArmorText" @bind:event="oninput"
                  placeholder="-----BEGIN AGE ENCRYPTED FILE-----&#10;..."></textarea>
        <InputFile class="form-control form-control-sm mt-2" OnChange="HandleFileAsync" accept=".age,.txt" />
        @if (binaryFileName is not null)
        {
            <small class="text-info">Uploaded binary: @binaryFileName (@binaryBytes?.Length bytes)</small>
        }
    </div>
</div>

@code {
    [Parameter] public string ArmorText { get; set; } = "";
    [Parameter] public EventCallback<string> ArmorTextChanged { get; set; }
    [Parameter] public EventCallback<byte[]?> BinaryChanged { get; set; }

    string? binaryFileName;
    byte[]? binaryBytes;

    async Task HandleFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 1_000_000).CopyToAsync(ms);
        var bytes = ms.ToArray();

        // Detect armored: starts with "-----BEGIN". If so, treat as text not binary.
        var looksArmored = bytes.Length >= 10
            && System.Text.Encoding.UTF8.GetString(bytes, 0, Math.Min(20, bytes.Length))
                .StartsWith("-----BEGIN", StringComparison.Ordinal);

        if (looksArmored)
        {
            await ArmorTextChanged.InvokeAsync(System.Text.Encoding.UTF8.GetString(bytes));
            binaryBytes = null;
            binaryFileName = null;
        }
        else
        {
            binaryBytes = bytes;
            binaryFileName = file.Name;
            await BinaryChanged.InvokeAsync(binaryBytes);
        }
    }
}
