@page "/"
@using Xecrets.Slip39
@using System.Text
@using QRCoder
@inject IJSRuntime JS

<PageTitle>SLIP-39 Seed Phrase Backup</PageTitle>

<div class="container-fluid py-4">
    <div class="text-center mb-4">
        <h2 class="text-white">🔐 BIP-39 Seed Phrase Backup using SLIP-39</h2>
        <p class="text-muted">Secure your wallet with multi-group secret sharing - 100% client-side, safe for Tor Browser</p>
    </div>

    <div class="row">
        <!-- LEFT SIDE: Input Configuration -->
        <div class="col-lg-6">
            <div class="card shadow-sm mb-4 sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">⚙️ Configuration</h5>
                </div>
                <div class="card-body" style="max-height: 85vh; overflow-y: auto;">
                    <h6>Step 1: Wallet Credentials</h6>
                    <div class="mb-3">
                        <label class="form-label small">BIP-39 Seed Phrase (12 words):</label>
                        <input type="text" class="form-control form-control-sm font-monospace" @bind="bip39SeedPhrase" @bind:event="oninput"
                               placeholder="abandon ability able about above absent..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">BIP-39 Passphrase (optional):</label>
                        <input type="text" class="form-control form-control-sm" @bind="bip39Passphrase" @bind:event="oninput"
                               placeholder="Leave empty if not used" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">SLIP-39 Passphrase (encrypts shares):</label>
                        <input type="text" class="form-control form-control-sm" @bind="slip39Passphrase"
                               placeholder="Strong passphrase" />
                        <small class="text-danger">⚠️ Must remember this!</small>
                    </div>

                    <button class="btn btn-sm btn-outline-info w-100 mb-3" @onclick="ShowTechnicalDetails" disabled="@isCalculatingDetails">
                        @if (isCalculatingDetails)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <text>Calculating...</text>
                        }
                        else if (showDetails)
                        {
                            <text>🔍 Hide Technical Details</text>
                        }
                        else
                        {
                            <text>🔍 Show Technical Details (Hex/Bytes)</text>
                        }
                    </button>

                    @if (showDetails && technicalDetails != null)
                    {
                        <div class="alert alert-info p-2 mb-3">
                            <small>
                                <strong>BIP-39 Seed:</strong><br />
                                Hex: <code class="small">@technicalDetails.SeedHex</code><br />
                                @technicalDetails.SeedBytes bytes (@technicalDetails.SeedBits bits)<br /><br />

                                <strong>BIP-39 Passphrase:</strong><br />
                                Hex: <code class="small">@technicalDetails.PassHex</code><br />
                                @technicalDetails.PassBytes bytes (@technicalDetails.PassBits bits)<br /><br />

                                <strong>Combined Master Secret:</strong><br />
                                Hex: <code class="small">@technicalDetails.CombinedHex</code><br />
                                Total: @technicalDetails.TotalBytes bytes (@technicalDetails.TotalBits bits)
                            </small>
                        </div>
                    }
                    @if (technicalDetailsError != null)
                    {
                        <div class="alert alert-danger p-2 mb-3">
                            <small><strong>Error:</strong> @technicalDetailsError</small>
                        </div>
                    }

                    <hr />

                    <h6>Step 2: Share Groups</h6>

                    <div class="mb-3">
                        <label class="form-label small">Group Threshold:</label>
                        <input type="number" class="form-control form-control-sm" @bind="groupThreshold" min="1" max="@groups.Count" />
                        <small class="text-muted">Groups needed to recover</small>
                    </div>

                    @for (int i = 0; i < groups.Count; i++)
                    {
                        var index = i;
                        var groupColor = GetGroupColor(index);

                        <div class="card mb-2" style="background-color: @groupColor; border-color: @groupColor;">
                            <div class="card-body p-2" style="background-color: @groupColor;">
                                <div class="row g-2 align-items-center">
                                    <div class="col-4">
                                        <input type="text" class="form-control form-control-sm" @bind="groups[index].Name"
                                               placeholder="Group name" />
                                    </div>
                                    <div class="col-2">
                                        <input type="number" class="form-control form-control-sm" @bind="groups[index].Threshold"
                                               min="1" max="@groups[index].Count" title="Threshold" />
                                    </div>
                                    <div class="col-1 text-center">
                                        <small style="color: #000;">of</small>
                                    </div>
                                    <div class="col-2">
                                        <input type="number" class="form-control form-control-sm" @bind="groups[index].Count"
                                               min="@groups[index].Threshold" max="16" title="Total shares" />
                                    </div>
                                    <div class="col-3">
                                        <button class="btn btn-sm btn-danger w-100" @onclick="() => RemoveGroup(index)">❌</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <button class="btn btn-sm btn-secondary mb-3 w-100" @onclick="AddGroup">
                        ➕ Add Group
                    </button>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg" @onclick="GenerateShares" disabled="@isGenerating">
                            @if (isGenerating)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <text>Generating...</text>
                            }
                            else
                            {
                                <text>🔐 Generate Shares</text>
                            }
                        </button>
                    </div>

                    @if (errorMessage != null)
                    {
                        <div class="alert alert-danger mt-3 p-2">
                            <small><strong>Error:</strong> @errorMessage</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT SIDE: Generated Output -->
        <div class="col-lg-6">
            @if (shares != null)
            {
                <div class="card shadow-sm mb-4" data-element-id="sharesCard">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">✅ Shares Generated</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning p-2">
                            <small><strong>⚠️ Important:</strong> Distribute shares securely. DO NOT store all in one place!</small>
                        </div>

                        @for (int i = 0; i < shares.Length; i++)
                        {
                            var groupConfig = groups[i];
                            var groupColor = GetGroupColor(i);

                            <div class="card mb-3" style="background-color: @groupColor; border-color: @groupColor;">
                                <div class="card-header" style="background-color: @groupColor; color: #fff; padding: 0.5rem;">
                                    <strong>@groupConfig.Name:</strong> @shares[i].Length share(s)
                                    <span class="badge bg-dark float-end">@groupConfig.Threshold-of-@groupConfig.Count</span>
                                </div>
                                <div class="card-body p-2" style="background-color: @groupColor;">
                                    @for (int j = 0; j < shares[i].Length; j++)
                                    {
                                        var shareText = shares[i][j].ToString();
                                        var qrDataUrl = GenerateQRCode(shareText);

                                        <div class="row g-2 mb-3 pb-3 @(j < shares[i].Length - 1 ? "border-bottom border-light" : "")">
                                            <div class="col-7">
                                                <label class="form-label small mb-1" style="color: #fff;"><strong>Share @(j + 1)</strong></label>
                                                <div class="input-group input-group-sm mb-2">
                                                    <textarea class="form-control font-monospace" style="font-size: 0.75rem; color: #fff; background-color: rgba(0,0,0,0.2); border-color: rgba(255,255,255,0.3); resize: none;"
                                                           rows="4" readonly>@shareText</textarea>
                                                    <button class="btn btn-outline-light" @onclick="() => CopyToClipboard(shareText)">
                                                        📋
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-5 text-center d-flex align-items-center justify-content-center">
                                                <div class="border border-light p-2 bg-white rounded">
                                                    <img src="@qrDataUrl" alt="QR @(j + 1)" class="img-fluid" style="max-width: 250px; width: 100%;" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">🔄 Test Recovery</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="form-label small">Shares (one per line):</label>
                            <textarea class="form-control form-control-sm font-monospace" @bind="recoverySharesText"
                                   placeholder="Paste shares here, one per line..." style="font-size: 0.75rem;"
                                   rows="6"></textarea>
                            <small class="text-muted">Paste all shares you have, one per line (need @groupThreshold groups minimum)</small>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small">SLIP-39 Passphrase:</label>
                            <input type="text" class="form-control form-control-sm" @bind="recoverySlip39Pass"
                                   placeholder="Enter passphrase" />
                        </div>

                        <button class="btn btn-info btn-sm w-100" @onclick="RecoverSecret" disabled="@isRecovering">
                            @if (isRecovering)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <text>Recovering...</text>
                            }
                            else
                            {
                                <text>🔓 Recover Wallet</text>
                            }
                        </button>

                        @if (recoveryResult != null)
                        {
                            <div class="alert @(recoveryResult.Success ? "alert-success" : "alert-danger") mt-2 p-2">
                                @if (recoveryResult.Success)
                                {
                                    <small>
                                        <strong>✅ Recovery Successful!</strong><br />
                                        <strong>Shares Used:</strong> @recoveryResult.SharesUsed<br />
                                        <strong>Groups:</strong> @recoveryResult.GroupsUsed<br /><br />
                                        <strong>BIP-39 Seed:</strong><br />
                                        <code class="small">@recoveryResult.RecoveredSeed</code><br /><br />
                                        <strong>BIP-39 Pass:</strong> @(string.IsNullOrEmpty(recoveryResult.RecoveredPassphrase) ? "(none)" : recoveryResult.RecoveredPassphrase)<br />
                                        <strong>Match:</strong> @(recoveryResult.MatchesOriginal ? "✅ Yes" : "❌ No")
                                    </small>
                                }
                                else
                                {
                                    <small><strong>❌ Failed:</strong> @recoveryResult.ErrorMessage</small>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm" style="opacity: 0.6;">
                    <div class="card-body text-center py-5">
                        <h5 class="text-muted">👈 Configure and generate shares</h5>
                        <p class="text-muted small">Results will appear here</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Input fields with auto-recalc if details shown
    private string _bip39SeedPhrase = "wrist eye before pact minute dilemma other entry escape vapor imitate history";
    private string bip39SeedPhrase
    {
        get => _bip39SeedPhrase;
        set
        {
            _bip39SeedPhrase = value;
            if (showDetails)
                _ = RecalculateTechnicalDetails();
        }
    }

    private string _bip39Passphrase = "MyWalletPass123";
    private string bip39Passphrase
    {
        get => _bip39Passphrase;
        set
        {
            _bip39Passphrase = value;
            if (showDetails)
                _ = RecalculateTechnicalDetails();
        }
    }

    private string slip39Passphrase = "SLIP39EncryptKey";

    // Debouncing
    private CancellationTokenSource? _debounceTokenSource;

    // User-selected colors, darkened for better contrast on dark theme
    private readonly string[] groupColors = new[]
    {
        "#694B9B", // Darkened purple
        "#AB4A8D", // Darkened magenta
        "#CC5974", // Darkened pink
        "#CC785A", // Darkened coral
        "#CC9F4C", // Darkened yellow
        "#C7C65A"  // Darkened light yellow
    };

    // Group configuration
    private int groupThreshold = 2;
    private List<GroupConfig> groups = new()
    {
        new GroupConfig { Name = "Personal Backup #1", Threshold = 1, Count = 1 },
        new GroupConfig { Name = "Personal Backup #2", Threshold = 1, Count = 1 },
        new GroupConfig { Name = "Friends", Threshold = 3, Count = 5 },
        new GroupConfig { Name = "Family", Threshold = 2, Count = 6 }
    };

    // State
    private string? errorMessage;
    private bool isGenerating;
    private bool isRecovering;
    private bool isCalculatingDetails;
    private bool showDetails;

    private Share[][]? shares;
    private TechnicalDetails? technicalDetails;
    private string? technicalDetailsError;

    // Recovery inputs
    private string recoverySharesText = "";
    private string recoverySlip39Pass = "";
    private RecoveryResult? recoveryResult;

    private async Task ShowTechnicalDetails()
    {
        if (showDetails)
        {
            showDetails = false;
            return;
        }

        showDetails = true;
        await CalculateTechnicalDetailsAsync();
    }

    private async Task RecalculateTechnicalDetails()
    {
        // Cancel previous calculation
        _debounceTokenSource?.Cancel();
        _debounceTokenSource = new CancellationTokenSource();
        var token = _debounceTokenSource.Token;

        try
        {
            await Task.Delay(800, token); // Wait 800ms after user stops typing
            await CalculateTechnicalDetailsAsync();
        }
        catch (TaskCanceledException)
        {
            // Expected when cancelled
        }
    }

    private async Task CalculateTechnicalDetailsAsync()
    {
        isCalculatingDetails = true;
        technicalDetailsError = null;
        StateHasChanged();

        await Task.Delay(10);

        try
        {
            await Task.Run(() =>
            {
                var bip39SeedBytes = bip39SeedPhrase.FromBip39();
                var bip39PassBytes = Encoding.UTF8.GetBytes(bip39Passphrase ?? "");
                var masterSecret = bip39SeedBytes.Concat(bip39PassBytes).ToArray();

                if (masterSecret.Length % 2 != 0)
                {
                    masterSecret = masterSecret.Concat(new byte[] { 0xFF }).ToArray();
                }

                technicalDetails = new TechnicalDetails
                {
                    SeedHex = Convert.ToHexString(bip39SeedBytes),
                    SeedBytes = bip39SeedBytes.Length,
                    SeedBits = bip39SeedBytes.Length * 8,
                    PassHex = Convert.ToHexString(bip39PassBytes),
                    PassBytes = bip39PassBytes.Length,
                    PassBits = bip39PassBytes.Length * 8,
                    CombinedHex = Convert.ToHexString(masterSecret),
                    TotalBytes = masterSecret.Length,
                    TotalBits = masterSecret.Length * 8
                };
            });
        }
        catch (Exception ex)
        {
            technicalDetailsError = ex.Message;
        }
        finally
        {
            isCalculatingDetails = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetGroupColor(int index) => groupColors[index % groupColors.Length];

    private void AddGroup()
    {
        groups.Add(new GroupConfig { Name = $"Group {groups.Count}", Threshold = 2, Count = 3 });
    }

    private void RemoveGroup(int index)
    {
        if (groups.Count > 1)
            groups.RemoveAt(index);
    }

    private async Task GenerateShares()
    {
        isGenerating = true;
        errorMessage = null;
        shares = null;
        StateHasChanged();

        await Task.Delay(10);

        try
        {
            var sss = new ShamirsSecretSharing(new StrongRandom());

            var bip39SeedBytes = bip39SeedPhrase.FromBip39();
            var bip39PassBytes = Encoding.UTF8.GetBytes(bip39Passphrase ?? "");
            var masterSecret = bip39SeedBytes.Concat(bip39PassBytes).ToArray();

            if (masterSecret.Length % 2 != 0)
            {
                masterSecret = masterSecret.Concat(new byte[] { 0xFF }).ToArray();
            }

            shares = sss.GenerateShares(
                extendable: true,
                iterationExponent: 2,
                groupThreshold: groupThreshold,
                groups: groups.Select(g => new Group(ShareThreshold: g.Threshold, ShareCount: g.Count)).ToArray(),
                passphrase: slip39Passphrase,
                masterSecret: masterSecret
            );

            StateHasChanged();
            await Task.Delay(100);
            await JS.InvokeVoidAsync("scrollToElement", "sharesCard");
        }
        catch (Exception ex)
        {
            errorMessage = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task RecoverSecret()
    {
        isRecovering = true;
        recoveryResult = null;
        StateHasChanged();

        await Task.Delay(10);

        try
        {
            if (string.IsNullOrWhiteSpace(recoverySharesText))
            {
                throw new InvalidOperationException("Please enter at least one share");
            }

            // Parse shares from textarea (one per line)
            var shareLines = recoverySharesText
                .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(line => !string.IsNullOrWhiteSpace(line))
                .ToArray();

            if (shareLines.Length == 0)
            {
                throw new InvalidOperationException("No valid shares found");
            }

            var parsedShares = shareLines.Select(line => Share.Parse(line.Trim())).ToArray();

            var sss = new ShamirsSecretSharing(new StrongRandom());
            var recovery = sss.CombineShares(parsedShares, recoverySlip39Pass);

            if (recovery.Secret.Length == 0)
            {
                throw new InvalidOperationException("Insufficient shares or groups to recover secret");
            }

            // Get groups used
            var groupsUsed = parsedShares.Select(s => s.Prefix.GroupIndex).Distinct().OrderBy(g => g).ToArray();

            var recoveredBytes = recovery.Secret.TakeWhile(b => b != 0xFF).ToArray();
            var recoveredSeedBytes = recoveredBytes.Take(16).ToArray();
            var recoveredPassBytes = recoveredBytes.Skip(16).ToArray();

            var recoveredSeed = recoveredSeedBytes.ToBip39();
            var recoveredPass = Encoding.UTF8.GetString(recoveredPassBytes);

            var matchesOriginal = recoveredSeed == bip39SeedPhrase &&
                                 recoveredPass == (bip39Passphrase ?? "");

            recoveryResult = new RecoveryResult
            {
                Success = true,
                RecoveredSeed = recoveredSeed,
                RecoveredPassphrase = recoveredPass,
                MatchesOriginal = matchesOriginal,
                SharesUsed = parsedShares.Length,
                GroupsUsed = string.Join(", ", groupsUsed.Select(g => $"Group {g}"))
            };
        }
        catch (Exception ex)
        {
            recoveryResult = new RecoveryResult
            {
                Success = false,
                ErrorMessage = ex.Message
            };
        }
        finally
        {
            isRecovering = false;
        }
    }

    private string GenerateQRCode(string text)
    {
        try
        {
            using var qrGenerator = new QRCodeGenerator();
            using var qrCodeData = qrGenerator.CreateQrCode(text, QRCodeGenerator.ECCLevel.M);
            using var qrCode = new PngByteQRCode(qrCodeData);
            var qrCodeBytes = qrCode.GetGraphic(5);
            return $"data:image/png;base64,{Convert.ToBase64String(qrCodeBytes)}";
        }
        catch
        {
            return "";
        }
    }

    private async Task CopyToClipboard(string text)
    {
        await Task.CompletedTask;
    }

    private class GroupConfig
    {
        public string Name { get; set; } = "";
        public int Threshold { get; set; }
        public int Count { get; set; }
    }

    private class TechnicalDetails
    {
        public string SeedHex { get; set; } = "";
        public int SeedBytes { get; set; }
        public int SeedBits { get; set; }
        public string PassHex { get; set; } = "";
        public int PassBytes { get; set; }
        public int PassBits { get; set; }
        public string CombinedHex { get; set; } = "";
        public int TotalBytes { get; set; }
        public int TotalBits { get; set; }
    }

    private class RecoveryResult
    {
        public bool Success { get; set; }
        public string? RecoveredSeed { get; set; }
        public string? RecoveredPassphrase { get; set; }
        public bool MatchesOriginal { get; set; }
        public string? ErrorMessage { get; set; }
        public int SharesUsed { get; set; }
        public string GroupsUsed { get; set; } = "";
    }
}
