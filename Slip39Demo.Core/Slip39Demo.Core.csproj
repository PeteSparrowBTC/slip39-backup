<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- AgeSharp NuGet was dropped in favour of the patched fork at
         third_party/AgeSharp (branch wasm-bouncy-chacha), which swaps the
         BCL ChaCha20Poly1305 (UnsupportedOSPlatform("browser")) for a
         BouncyCastle-backed adapter so the library works under Blazor WASM. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="CSharpFunctionalExtensions" Version="3.6.0" />
    <!-- 2.3.1668 is the first release carrying the GenerateId fix (xecrets/xecrets-slip39#28):
         id is now masked to 15 bits (& 0x7FFF) instead of `% ((1<<16)-1)`, which produced
         negative ids (OverflowException) or silently truncated 16-bit ids on the
         extendable=false path. Bumped from 2.3.1315. -->
    <PackageReference Include="Xecrets.Slip39" Version="2.3.1668" />
  </ItemGroup>
  <ItemGroup>
    <!-- Patched AgeSharp consumed via git submodule + ProjectReference. See
         third_party/AgeSharp/Age/Crypto/BcChaCha20Poly1305.cs for the WASM
         compatibility shim. -->
    <ProjectReference Include="..\third_party\AgeSharp\Age\Age.csproj" />
  </ItemGroup>
</Project>
