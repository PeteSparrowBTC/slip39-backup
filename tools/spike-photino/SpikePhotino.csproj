<!-- Throwaway Phase-0 spike (see docs/specs/2026-08-01-native-window-appimage-design.md).
     Verifies on a real Tails stick that Photino/WebKitGTK can: print, run WebCrypto,
     and show a native save dialog. Deleted once the verdict is recorded in the spec. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpikePhotino</RootNamespace>
    <!-- Photino.Blazor 4.x targets net8/net9; NU1603-style minor mismatch is fine under net10 -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
