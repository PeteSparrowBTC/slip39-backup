{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin +main)",
      "Bash(git push -u origin main)",
      "Bash(git push --set-upstream origin main)",
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git push --force-with-lease)",
      "Bash(gh pr merge)",
      "Bash(gh api -X PUT)",
      "Bash(gh api --method PUT)",
      "Bash(gh api -X DELETE)",
      "Bash(gh api --method DELETE)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin main:)",
      "PowerShell(git push origin HEAD:main)",
      "PowerShell(git push origin +main)",
      "PowerShell(git push -u origin main)",
      "PowerShell(git push --set-upstream origin main)",
      "PowerShell(git push --force)",
      "PowerShell(git push -f)",
      "PowerShell(git push --force-with-lease)",
      "PowerShell(gh pr merge)",
      "PowerShell(gh api -X PUT)",
      "PowerShell(gh api --method PUT)",
      "PowerShell(gh api -X DELETE)",
      "PowerShell(gh api --method DELETE)"
    ]
  }
}
